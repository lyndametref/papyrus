{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    // Default shell behavior.
    { "action": "shell", "resource": "*", "effect": "allow" },

    // Git: block everything, then allow only commit and merge.
    { "action": "shell", "resource": "*git *", "effect": "deny" },
    { "action": "shell", "resource": "*git commit *", "effect": "allow" },
    { "action": "shell", "resource": "*git merge *", "effect": "allow" },

    // Privileged commands are re-denied after the git allows, so
    // "sudo git commit" cannot slip through.
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "passwd", "effect": "deny" },
    { "action": "shell", "resource": "passwd *", "effect": "deny" },
    { "action": "shell", "resource": "/usr/sbin/*", "effect": "deny" },
    { "action": "shell", "resource": "/sbin/*", "effect": "deny" },
    { "action": "shell", "resource": "~/share/**", "effect": "allow" },

    // External directory boundaries (converted from the old block).
    { "action": "external_directory", "resource": "/home/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/usr/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/etc/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/var/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/share/**", "effect": "allow" }
  ],

  "experimental": {
    "subagent_depth": 2
  }
}
